# ==========================================
# ScamShield Environment Configuration
# ==========================================

# Server Settings
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=127.0.0.1
CORS_ORIGINS=*

# Firebase Firestore Configuration (Optional)
# If left blank or file is not found, ScamShield automatically operates
# in resilient offline/local storage mode.
FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_COLLECTION_NAME=scam_reports
